# Copy to ~/.config/picnicart/env (OUTSIDE the repo) and fill in. Never commit the real file.
PICNIC_PROD_URL=https://<production-domain>
PICNIC_N8N_STAGING_URL=https://<n8n-staging-public-host>          # only used to wake it up (scale-to-zero)
PICNIC_N8N_WEBHOOK_URL=http://<server-tailnet-name>:<port>/webhook/<bot-webhook-path>
PICNIC_N8N_HEALTH_URL=http://<server-tailnet-name>:<port>/healthz
PICNIC_WA_PHONE=+<test number>
PICNIC_WA_PHONE_ID=<Meta phone number id>
PICNIC_WA_WABA_ID=<Meta WhatsApp business account id>
PICNIC_META_APP_ID=<Meta app id>
PICNIC_KEYCHAIN_SERVICE=<keychain item name that holds the WhatsApp token>
PICNIC_LOCAL_ACCOUNT_NAME="<name of the local Chatwoot account>"
PICNIC_LOCAL_ACCOUNT_ID=<same id as the staging account>
PICNIC_AGENT_USER_ID=<same id as the staging agent user>
PICNIC_BOT_USER_ID=<same id as the staging bot user>
PICNIC_BOT_LABELS="<labels the bot uses, space separated>"
# One-time: where to fetch the bot's API token from (used by `lucia.sh bot-token --from-server`)
PICNIC_BOT_TOKEN_SSH=<user>@<server>
PICNIC_BOT_TOKEN_REMOTE_FILE='<path of the env file on the server>'
PICNIC_BOT_TOKEN_VAR=<name of the variable that holds the token>
